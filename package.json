{
  "name": "nimpat-one-backend",
  "version": "0.1.0",
  "description": "Nimpat One central REST API — Nimpat Group of Companies",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "prisma:studio": "prisma studio",
    "openapi:export": "ts-node --transpile-only scripts/export-openapi.ts",
    "catalog:import": "ts-node --transpile-only prisma/catalog/import-catalog.ts",
    "catalog:apply": "ts-node --transpile-only prisma/catalog/apply-catalogue.ts",
    "catalog:apartments": "ts-node --transpile-only prisma/catalog/apply-apartments.ts",
    "catalog:stock": "ts-node --transpile-only prisma/catalog/apply-stock.ts",
    "test:paystack": "jest --config test/jest-e2e.json --runInBand paystack-live",
    "test:load": "ts-node --transpile-only scripts/load-test.ts",
    "client:generate": "npm run openapi:export && openapi-typescript docs/openapi/nimpat-one-api.v1.json -o clients/typescript/schema.d.ts"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.8",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^6.19.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "openapi-typescript": "^7.13.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "allowScripts": {
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@scarf/scarf": false
  },
  "overrides": {
    "multer": "2.5.0",
    "deepmerge-ts": "8.0.2"
  }
}
