// =============================================================================
// Nimpat One — central PostgreSQL schema
//
// Conventions
//  * Every money column is an exact integer in MINOR units (kobo for NGN),
//    stored as BIGINT and suffixed `Minor`. No floats/decimals for money.
//  * Table and column names are snake_case in PostgreSQL (@@map / @map).
//  * Status changes that matter commercially are append-only in *_history
//    or *_events tables; audit_logs records staff/admin actions.
//  * Some invariants are enforced in raw SQL inside the migration because
//    Prisma cannot express them (exclusion constraints against
//    double-booking, CHECK constraints on stock). See migration.sql.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum DivisionCode {
  WATER_DRINKS_WINES
  LUXURY_APARTMENTS
  AUTOMOBILES
  SPA_WELLNESS
  TRANSPORT_LOGISTICS
  RETAIL_GENERAL_SUPPLIES
  MEDIA_EVENTS_RENTALS
  REAL_ESTATE_INTERIOR
  ENTERTAINMENT
  PHARMACY
}

enum DivisionKind {
  PRIMARY
  DISCOVERY
}

enum UserType {
  CUSTOMER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum RoleCode {
  SUPER_ADMIN
  GROUP_MANAGEMENT
  FINANCE_OFFICER
  DEPARTMENT_MANAGER
  DEPARTMENT_STAFF
  CUSTOMER_SUPPORT
  CUSTOMER
  PHARMACIST
}

/// Availability stated by staff or a supplied list, for items with no live count.
enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
}

/// Set on pharmacy products only. Only a pharmacist may decide it.
enum PrescriptionStatus {
  NOT_REVIEWED
  NOT_REQUIRED
  REQUIRED
  RESTRICTED
}

enum TokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum StockMovementType {
  RECEIPT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum FulfilmentType {
  DELIVERY
  PICKUP
}

/// Fulfilment status only. Money is tracked separately in paymentStatus.
enum OrderStatus {
  PENDING // waiting for payment / acceptance (stock reserved)
  ACCEPTED
  PROCESSING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum DeliveryStatus {
  PENDING
  SCHEDULED
  DISPATCHED
  DELIVERED
  FAILED
  RETURNED
  CANCELLED
}

enum PaymentProvider {
  PAYSTACK
}

enum PaymentPurpose {
  ORDER
  APARTMENT_RESERVATION
  SERVICE_BOOKING
  SPA_APPOINTMENT
  VEHICLE_DEPOSIT
  LOGISTICS_REQUEST
  QUOTATION
}

/// Status of one payment record (one transfer / charge / collection).
/// Only SUCCESS counts towards the verified balance.
enum PaymentStatus {
  INITIALIZED
  PENDING // checkout started / transfer instructions issued
  AWAITING_VERIFICATION // customer reported a transfer or staff reported a collection
  SUCCESS // funds verified (Paystack verify API or finance confirmation)
  FAILED
  ABANDONED
  REVERSED
  REJECTED // finance could not find the funds
}

/// How the money moves. Paystack is the only online gateway.
enum PaymentMethod {
  PAYSTACK
  BANK_TRANSFER // direct transfer into a Nimpat bank account
  CASH
  CARD_TERMINAL // recorded manually; no terminal integration exists
}

/// Where the money was paid or collected.
enum CollectionPoint {
  ONLINE
  BANK
  DELIVERY
  SERVICE_LOCATION
}

/// Collection / reconciliation status of a payment record.
enum ReconciliationStatus {
  NOT_COLLECTED
  COLLECTION_REPORTED
  COLLECTION_VERIFIED
  RECONCILED
  DISPUTED
}

/// Payment status of an order or booking (derived from its payments).
enum PayableState {
  UNPAID
  AWAITING_VERIFICATION
  PARTIALLY_PAID
  PAID
  REFUNDED
  FAILED
}

/// Payment plan the customer chose at checkout.
enum PaymentOption {
  PAYSTACK
  BANK_TRANSFER
  PAY_ON_DELIVERY
  PAY_AT_LOCATION
}

enum DepositType {
  NONE
  PERCENT
  FIXED
}

/// When a booking is confirmed (department policy).
enum ConfirmationRule {
  FULL_PAYMENT
  DEPOSIT_VERIFIED
  STAFF_APPROVAL
}

/// Whether a catalogue / listing record has been confirmed by the company.
enum RecordVerification {
  VERIFIED
  AWAITING_CONFIRMATION
  DEV_SAMPLE
}

enum RefundStatus {
  NONE
  PENDING
  PROCESSING
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum RefundRecordStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ListingStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ReservationStatus {
  HOLD
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
  EXPIRED
}

enum VehicleCondition {
  BRAND_NEW
  FOREIGN_USED
  NIGERIAN_USED
}

enum VehicleStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum InquiryType {
  GENERAL
  TEST_DRIVE
  INSPECTION
  DEPOSIT_HOLD
  FINANCING
}

enum InquiryStatus {
  NEW
  CONTACTED
  SCHEDULED
  CLOSED_WON
  CLOSED_LOST
}

enum ServicePricingType {
  FIXED
  STARTING_FROM
  QUOTE_REQUIRED
}

enum BookingStatus {
  REQUESTED
  PENDING // accepted / priced, awaiting payment or the confirmation policy
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LogisticsType {
  PARCEL
  INTERSTATE_HAULAGE
  MOVING
}

enum LogisticsStatus {
  REQUESTED
  QUOTED
  CONFIRMED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum QuotationStatus {
  REQUESTED
  UNDER_REVIEW
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVERSAL
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

// -----------------------------------------------------------------------------
// Organisation
// -----------------------------------------------------------------------------

model Division {
  id          String       @id @default(uuid()) @db.Uuid
  code        DivisionCode @unique
  name        String
  slug        String       @unique
  kind        DivisionKind @default(PRIMARY)
  description String?
  isActive    Boolean      @default(true) @map("is_active")
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  departments       Department[]
  userRoles         UserRole[]
  categories        ProductCategory[]
  products          Product[]
  stockLocations    StockLocation[]
  carts             Cart[]
  orders            Order[]
  deliveryZones     DeliveryZone[]
  payments          Payment[]
  properties        Property[]
  vehicles          Vehicle[]
  serviceOfferings  ServiceOffering[]
  serviceBookings   ServiceBooking[]
  spaTreatments     SpaTreatment[]
  spaPractitioners  SpaPractitioner[]
  logisticsRequests LogisticsRequest[]
  quotations        Quotation[]
  loyaltyRule       LoyaltyRule?
  loyaltyTxs        LoyaltyTransaction[]
  auditLogs         AuditLog[]
  bankAccounts      BankAccount[]
  serviceLocations  ServiceLocation[]
  paymentPolicies   PaymentPolicy[]

  @@map("divisions")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  divisionId  String?  @map("division_id") @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division?      @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  staff    StaffProfile[]

  @@index([divisionId])
  @@map("departments")
}

// -----------------------------------------------------------------------------
// Identity, access control and sessions
// -----------------------------------------------------------------------------

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String     @unique // stored lower-cased
  phone           String?    @unique // E.164
  passwordHash    String     @map("password_hash")
  type            UserType   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  failedLogins    Int        @default(0) @map("failed_logins")
  lockedUntil     DateTime?  @map("locked_until") @db.Timestamptz(3)
  /// A guest buys without an account. Their sign-in email is an internal placeholder; contactEmail and contactPhone are real.
  isGuest         Boolean    @default(false) @map("is_guest")
  contactEmail    String?    @map("contact_email")
  contactPhone    String?    @map("contact_phone")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customerProfile    CustomerProfile?
  staffProfile       StaffProfile?
  roles              UserRole[]
  sessions           Session[]
  tokens             VerificationToken[]
  addresses          Address[]
  favorites          Favorite[]
  carts              Cart[]
  orders             Order[]
  payments           Payment[]
  reservations       Reservation[]
  vehicleInquiries   VehicleInquiry[]     @relation("InquiryCustomer")
  assignedInquiries  VehicleInquiry[]     @relation("InquiryAssignee")
  serviceBookings    ServiceBooking[]
  spaAppointments    SpaAppointment[]
  logisticsRequests  LogisticsRequest[]
  quotations         Quotation[]
  loyaltyAccount     LoyaltyAccount?
  notifications      Notification[]
  auditLogs          AuditLog[]
  stockMovements     StockMovement[]
  orderStatusChanges OrderStatusHistory[]
  assignedDeliveries Delivery[]
  refundsRequested   Refund[]
  paymentsReported   Payment[]            @relation("PaymentReporter")
  paymentsVerified   Payment[]            @relation("PaymentVerifier")
  paymentsReconciled Payment[]            @relation("PaymentReconciler")

  @@index([type, status])
  @@map("users")
}

model CustomerProfile {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  firstName      String    @map("first_name")
  lastName       String    @map("last_name")
  dateOfBirth    DateTime? @map("date_of_birth") @db.Date
  marketingOptIn Boolean   @default(false) @map("marketing_opt_in")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

model StaffProfile {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  employeeNumber String   @unique @map("employee_number")
  firstName      String   @map("first_name")
  lastName       String   @map("last_name")
  jobTitle       String?  @map("job_title")
  departmentId   String?  @map("department_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department?      @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  practitioner SpaPractitioner?

  @@index([departmentId])
  @@map("staff_profiles")
}

model Role {
  id               String   @id @default(uuid()) @db.Uuid
  code             RoleCode @unique
  name             String
  description      String?
  // Group-wide roles ignore division scope; scoped roles need a division.
  isDivisionScoped Boolean  @default(false) @map("is_division_scoped")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g. "products:write"
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// A role granted to a user, optionally scoped to one division
/// (department-level permission). divisionId NULL = group-wide.
model UserRole {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  roleId      String   @map("role_id") @db.Uuid
  divisionId  String?  @map("division_id") @db.Uuid
  grantedById String?  @map("granted_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  // NULL-safe uniqueness is added in migration.sql (NULLS NOT DISTINCT).
  @@index([userId])
  @@index([divisionId])
  @@map("user_roles")
}

/// Refresh-token session. Only a SHA-256 hash of the opaque token is stored.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  rotatedFromId    String?   @map("rotated_from_id") @db.Uuid
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("sessions")
}

/// Single-use email-verification / password-reset tokens (hash only).
model VerificationToken {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(3)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model Address {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  label         String?
  recipientName String    @map("recipient_name")
  phone         String
  line1         String
  line2         String?
  landmark      String?
  city          String
  lga           String?
  state         String
  country       String    @default("NG") @db.Char(2)
  latitude      Float?
  longitude     Float?
  isDefault     Boolean   @default(false) @map("is_default")
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// -----------------------------------------------------------------------------
// Catalogue & inventory (used first by Water, Drinks & Wines; reusable by
// Retail & General Supplies and Media rentals)
// -----------------------------------------------------------------------------

model ProductCategory {
  id          String   @id @default(uuid()) @db.Uuid
  divisionId  String   @map("division_id") @db.Uuid
  parentId    String?  @map("parent_id") @db.Uuid
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([divisionId, slug])
  @@index([parentId])
  @@map("product_categories")
}

model Product {
  id              String             @id @default(uuid()) @db.Uuid
  divisionId      String             @map("division_id") @db.Uuid
  categoryId      String?            @map("category_id") @db.Uuid
  name            String
  slug            String             @unique
  description     String?
  brand           String?
  status          ProductStatus      @default(DRAFT)
  isDeliverable   Boolean            @default(true) @map("is_deliverable")
  isAgeRestricted Boolean            @default(false) @map("is_age_restricted") // wines & spirits
  verification    RecordVerification @default(AWAITING_CONFIRMATION)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById    String?            @map("verified_by_id") @db.Uuid
  /// When set, this replaces the live count as the availability shown.
  listedAvailability    ProductAvailability? @map("listed_availability")
  /// Off until staff confirm the item can really be supplied.
  purchaseEnabled       Boolean              @default(true) @map("purchase_enabled")
  prescriptionStatus    PrescriptionStatus?  @map("prescription_status")
  pharmacistApprovedAt  DateTime?            @map("pharmacist_approved_at") @db.Timestamptz(3)
  pharmacistApprovedById String?             @map("pharmacist_approved_by_id") @db.Uuid
  /// Staff-only note on what must be checked before publishing.
  verificationNote      String?              @map("verification_note")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  category ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  images   ProductImage[]

  @@index([divisionId, status])
  @@index([categoryId])
  @@map("products")
  homeSlides HomeSlide[]
}

model ProductVariant {
  id                  String   @id @default(uuid()) @db.Uuid
  productId           String   @map("product_id") @db.Uuid
  sku                 String   @unique
  name                String // e.g. "Pack of 12 x 75cl"
  /// Null means the price is not published. It is never zero for that.
  unitPriceMinor      BigInt?  @map("unit_price_minor")
  /// Historical closing stock from a supplied list. Not live stock.
  recordedStockQty    Int?     @map("recorded_stock_qty")
  recordedStockAt     DateTime? @map("recorded_stock_at") @db.Date
  compareAtPriceMinor BigInt?  @map("compare_at_price_minor")
  currency            String   @default("NGN") @db.Char(3)
  unitsPerPack        Int      @default(1) @map("units_per_pack")
  weightGrams         Int?     @map("weight_grams")
  minOrderQty         Int      @default(1) @map("min_order_qty")
  maxOrderQty         Int?     @map("max_order_qty")
  isActive            Boolean  @default(true) @map("is_active")
  sortOrder           Int      @default(0) @map("sort_order")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  images ProductImage[]
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([productId, isActive])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  /// Set when the photo shows one size or pack rather than the whole product.
  variantId String?  @map("variant_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@map("product_images")
}

model StockLocation {
  id         String   @id @default(uuid()) @db.Uuid
  divisionId String   @map("division_id") @db.Uuid
  code       String   @unique
  name       String
  city       String?
  state      String?
  isDefault  Boolean  @default(false) @map("is_default")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division  Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  levels    StockLevel[]
  movements StockMovement[]
  orders    Order[]

  @@index([divisionId])
  @@map("stock_locations")
}

/// Stock record: current stock per variant per location.
/// on_hand >= reserved >= 0 is a CHECK constraint (migration.sql). All
/// mutations go through atomic conditional UPDATEs in InventoryService.
model StockLevel {
  id               String   @id @default(uuid()) @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  locationId       String   @map("location_id") @db.Uuid
  quantityOnHand   Int      @default(0) @map("quantity_on_hand")
  quantityReserved Int      @default(0) @map("quantity_reserved")
  reorderLevel     Int      @default(0) @map("reorder_level")
  version          Int      @default(0)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@unique([variantId, locationId])
  @@map("stock_levels")
}

/// Immutable inventory ledger.
model StockMovement {
  id         String            @id @default(uuid()) @db.Uuid
  variantId  String            @map("variant_id") @db.Uuid
  locationId String            @map("location_id") @db.Uuid
  type       StockMovementType
  quantity   Int // signed effect on the affected bucket
  orderId    String?           @map("order_id") @db.Uuid
  actorId    String?           @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  variant  ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  location StockLocation  @relation(fields: [locationId], references: [id], onDelete: Restrict)
  order    Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  actor    User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

// -----------------------------------------------------------------------------
// Carts, orders, deliveries
// -----------------------------------------------------------------------------

/// One active cart per customer per division. Carts never store prices;
/// prices are always read from product_variants at quote/checkout time.
model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  divisionId String     @map("division_id") @db.Uuid
  status     CartStatus @default(ACTIVE)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  division Division   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  items    CartItem[]

  @@unique([userId, divisionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  variantId String   @map("variant_id") @db.Uuid
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model DeliveryZone {
  id                   String             @id @default(uuid()) @db.Uuid
  divisionId           String             @map("division_id") @db.Uuid
  name                 String
  state                String
  cities               String[] // lower-cased; empty = whole state
  feeMinor             BigInt             @map("fee_minor")
  freeAboveMinor       BigInt?            @map("free_above_minor")
  estimatedHours       Int?               @map("estimated_hours")
  /// Pay on delivery allowed in this zone (the division policy must allow it too).
  payOnDeliveryEnabled Boolean            @default(false) @map("pay_on_delivery_enabled")
  verification         RecordVerification @default(AWAITING_CONFIRMATION)
  verifiedAt           DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById         String?            @map("verified_by_id") @db.Uuid
  isActive             Boolean            @default(true) @map("is_active")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  division   Division   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  deliveries Delivery[]

  @@unique([divisionId, name])
  @@index([divisionId, state])
  @@map("delivery_zones")
}

model Order {
  id                   String         @id @default(uuid()) @db.Uuid
  orderNumber          String         @unique @map("order_number")
  userId               String         @map("user_id") @db.Uuid
  divisionId           String         @map("division_id") @db.Uuid
  status               OrderStatus    @default(PENDING)
  paymentOption        PaymentOption  @default(PAYSTACK) @map("payment_option")
  paymentStatus        PayableState   @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt         @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt         @default(0) @map("deposit_required_minor")
  fulfilmentType       FulfilmentType @default(DELIVERY) @map("fulfilment_type")
  currency             String         @default("NGN") @db.Char(3)
  subtotalMinor        BigInt         @map("subtotal_minor")
  deliveryFeeMinor     BigInt         @default(0) @map("delivery_fee_minor")
  discountMinor        BigInt         @default(0) @map("discount_minor")
  totalMinor           BigInt         @map("total_minor")
  addressId            String?        @map("address_id") @db.Uuid
  deliveryAddress      Json?          @map("delivery_address") // immutable snapshot
  stockLocationId      String?        @map("stock_location_id") @db.Uuid
  customerNote         String?        @map("customer_note")
  idempotencyKey       String?        @map("idempotency_key")
  expiresAt            DateTime?      @map("expires_at") @db.Timestamptz(3)
  paidAt               DateTime?      @map("paid_at") @db.Timestamptz(3)
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz(3)
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user           User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  division       Division             @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  address        Address?             @relation(fields: [addressId], references: [id], onDelete: SetNull)
  stockLocation  StockLocation?       @relation(fields: [stockLocationId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  delivery       Delivery?
  payments       Payment[]
  stockMovements StockMovement[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([divisionId, status, createdAt])
  @@index([status, expiresAt])
  @@map("orders")
}

model OrderItem {
  id             String @id @default(uuid()) @db.Uuid
  orderId        String @map("order_id") @db.Uuid
  variantId      String @map("variant_id") @db.Uuid
  productName    String @map("product_name") // snapshot
  variantName    String @map("variant_name") // snapshot
  sku            String
  unitPriceMinor BigInt @map("unit_price_minor") // snapshot of server price
  quantity       Int
  lineTotalMinor BigInt @map("line_total_minor")

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(uuid()) @db.Uuid
  orderId    String       @map("order_id") @db.Uuid
  fromStatus OrderStatus? @map("from_status")
  toStatus   OrderStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Delivery {
  id            String         @id @default(uuid()) @db.Uuid
  orderId       String         @unique @map("order_id") @db.Uuid
  zoneId        String?        @map("zone_id") @db.Uuid
  status        DeliveryStatus @default(PENDING)
  feeMinor      BigInt         @map("fee_minor")
  trackingCode  String         @unique @map("tracking_code")
  assignedToId  String?        @map("assigned_to_id") @db.Uuid
  scheduledFor  DateTime?      @map("scheduled_for") @db.Timestamptz(3)
  dispatchedAt  DateTime?      @map("dispatched_at") @db.Timestamptz(3)
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(3)
  failureReason String?        @map("failure_reason")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  order      Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone       DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  assignedTo User?         @relation(fields: [assignedToId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assignedToId])
  @@map("deliveries")
}

// -----------------------------------------------------------------------------
// Payments (shared by all divisions)
// -----------------------------------------------------------------------------

model Payment {
  id                    String               @id @default(uuid()) @db.Uuid
  reference             String               @unique
  provider              PaymentProvider      @default(PAYSTACK)
  method                PaymentMethod        @default(PAYSTACK)
  collectionPoint       CollectionPoint      @default(ONLINE) @map("collection_point")
  reconciliationStatus  ReconciliationStatus @default(NOT_COLLECTED) @map("reconciliation_status")
  purpose               PaymentPurpose
  divisionId            String               @map("division_id") @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  // Exactly one payable is set (CHECK constraint in migration.sql).
  orderId               String?              @map("order_id") @db.Uuid
  reservationId         String?              @map("reservation_id") @db.Uuid
  serviceBookingId      String?              @map("service_booking_id") @db.Uuid
  spaAppointmentId      String?              @map("spa_appointment_id") @db.Uuid
  vehicleInquiryId      String?              @map("vehicle_inquiry_id") @db.Uuid
  logisticsRequestId    String?              @map("logistics_request_id") @db.Uuid
  quotationId           String?              @map("quotation_id") @db.Uuid
  amountMinor           BigInt               @map("amount_minor")
  currency              String               @default("NGN") @db.Char(3)
  status                PaymentStatus        @default(INITIALIZED)
  refundStatus          RefundStatus         @default(NONE) @map("refund_status")
  refundedMinor         BigInt               @default(0) @map("refunded_minor")
  idempotencyKey        String?              @map("idempotency_key")
  authorizationUrl      String?              @map("authorization_url")
  accessCode            String?              @map("access_code")
  providerTransactionId String?              @unique @map("provider_transaction_id")
  channel               String?
  gatewayResponse       String?              @map("gateway_response")
  feesMinor             BigInt?              @map("fees_minor")
  paidAt                DateTime?            @map("paid_at") @db.Timestamptz(3)
  verifiedAt            DateTime?            @map("verified_at") @db.Timestamptz(3)
  lastCheckedAt         DateTime?            @map("last_checked_at") @db.Timestamptz(3)
  failureReason         String?              @map("failure_reason")
  metadata              Json?
  // ---- manual payments (bank transfer, cash, terminal) -------------------
  beneficiaryAccountId  String?              @map("beneficiary_account_id") @db.Uuid
  serviceLocationId     String?              @map("service_location_id") @db.Uuid
  claimedAmountMinor    BigInt?              @map("claimed_amount_minor")
  payerName             String?              @map("payer_name")
  customerReference     String?              @map("customer_reference")
  verificationReference String?              @map("verification_reference")
  receiptNumber         String?              @unique @map("receipt_number")
  transferredAt         DateTime?            @map("transferred_at") @db.Timestamptz(3)
  collectedAt           DateTime?            @map("collected_at") @db.Timestamptz(3)
  reportedById          String?              @map("reported_by_id") @db.Uuid
  reportedAt            DateTime?            @map("reported_at") @db.Timestamptz(3)
  verifiedById          String?              @map("verified_by_id") @db.Uuid
  reconciledById        String?              @map("reconciled_by_id") @db.Uuid
  reconciledAt          DateTime?            @map("reconciled_at") @db.Timestamptz(3)
  settlementReference   String?              @map("settlement_reference")
  rejectionReason       String?              @map("rejection_reason")
  disputeReason         String?              @map("dispute_reason")
  disputedAt            DateTime?            @map("disputed_at") @db.Timestamptz(3)
  disputedById          String?              @map("disputed_by_id") @db.Uuid
  note                  String?
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  division           Division          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  user               User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  order              Order?            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  reservation        Reservation?      @relation(fields: [reservationId], references: [id], onDelete: Restrict)
  serviceBooking     ServiceBooking?   @relation(fields: [serviceBookingId], references: [id], onDelete: Restrict)
  spaAppointment     SpaAppointment?   @relation(fields: [spaAppointmentId], references: [id], onDelete: Restrict)
  vehicleInquiry     VehicleInquiry?   @relation(fields: [vehicleInquiryId], references: [id], onDelete: Restrict)
  logisticsRequest   LogisticsRequest? @relation(fields: [logisticsRequestId], references: [id], onDelete: Restrict)
  quotation          Quotation?        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  refunds            Refund[]
  events             PaymentEvent[]
  proofs             PaymentProof[]
  beneficiaryAccount BankAccount?      @relation(fields: [beneficiaryAccountId], references: [id], onDelete: Restrict)
  serviceLocation    ServiceLocation?  @relation(fields: [serviceLocationId], references: [id], onDelete: Restrict)
  reportedBy         User?             @relation("PaymentReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  verifiedBy         User?             @relation("PaymentVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  reconciledBy       User?             @relation("PaymentReconciler", fields: [reconciledById], references: [id], onDelete: Restrict)

  @@unique([userId, idempotencyKey])
  @@index([status, createdAt])
  @@index([divisionId, status, createdAt])
  @@index([method, status, createdAt])
  @@index([reconciliationStatus, createdAt])
  @@index([reportedById, createdAt])
  @@index([orderId])
  @@index([reservationId])
  @@map("payments")
}

/// Every inbound webhook (valid or not) and verification result, for
/// idempotency and reconciliation. `eventKey` is unique so a replayed
/// webhook is stored once and processed once.
model PaymentEvent {
  id              String          @id @default(uuid()) @db.Uuid
  provider        PaymentProvider @default(PAYSTACK)
  eventKey        String          @unique @map("event_key")
  eventType       String          @map("event_type")
  source          String // "webhook" | "verify" | "reconcile"
  paymentId       String?         @map("payment_id") @db.Uuid
  reference       String?
  signatureValid  Boolean         @map("signature_valid")
  payload         Json
  processedAt     DateTime?       @map("processed_at") @db.Timestamptz(3)
  processingError String?         @map("processing_error")
  actorId         String?         @map("actor_id") @db.Uuid // staff member for manual actions
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([reference])
  @@index([paymentId, createdAt])
  @@map("payment_events")
}

model Refund {
  id               String             @id @default(uuid()) @db.Uuid
  paymentId        String             @map("payment_id") @db.Uuid
  amountMinor      BigInt             @map("amount_minor")
  status           RefundRecordStatus @default(PENDING)
  providerRefundId String?            @unique @map("provider_refund_id")
  reason           String?
  requestedById    String?            @map("requested_by_id") @db.Uuid
  processedAt      DateTime?          @map("processed_at") @db.Timestamptz(3)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User?   @relation(fields: [requestedById], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@map("refunds")
}

/// Private proof-of-payment file uploaded by a customer. Evidence only —
/// never treated as confirmation of settled funds.
model PaymentProof {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @map("payment_id") @db.Uuid
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  storageKey   String   @unique @map("storage_key")
  fileName     String   @map("file_name")
  mimeType     String   @map("mime_type")
  sizeBytes    Int      @map("size_bytes")
  sha256       String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@map("payment_proofs")
}

/// Nimpat bank account customers may transfer into. Only what a customer
/// needs to make a transfer is stored (no BVN, signatories or balances).
model BankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  divisionId    String?  @map("division_id") @db.Uuid // NULL = group-wide default
  label         String
  bankName      String   @map("bank_name")
  accountName   String   @map("account_name")
  accountNumber String   @map("account_number") // 10-digit NUBAN
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("created_by_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division? @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([divisionId, isActive])
  @@map("bank_accounts")
}

/// A Nimpat business location where customers can pay in person.
model ServiceLocation {
  id                  String   @id @default(uuid()) @db.Uuid
  divisionId          String   @map("division_id") @db.Uuid
  code                String   @unique
  name                String
  addressLine         String   @map("address_line")
  city                String
  state               String
  acceptsCash         Boolean  @default(true) @map("accepts_cash")
  acceptsBankTransfer Boolean  @default(true) @map("accepts_bank_transfer")
  acceptsCardTerminal Boolean  @default(false) @map("accepts_card_terminal")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division  @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@index([divisionId, isActive])
  @@map("service_locations")
}

/// Per-division, per-transaction-type payment rules (admin configured).
model PaymentPolicy {
  id                         String           @id @default(uuid()) @db.Uuid
  divisionId                 String           @map("division_id") @db.Uuid
  purpose                    PaymentPurpose
  allowPaystack              Boolean          @default(true) @map("allow_paystack")
  allowBankTransfer          Boolean          @default(false) @map("allow_bank_transfer")
  allowPayOnDelivery         Boolean          @default(false) @map("allow_pay_on_delivery")
  allowPayAtLocation         Boolean          @default(false) @map("allow_pay_at_location")
  payOnDeliveryMinOrderMinor BigInt?          @map("pay_on_delivery_min_order_minor")
  payOnDeliveryMaxOrderMinor BigInt?          @map("pay_on_delivery_max_order_minor")
  depositType                DepositType      @default(NONE) @map("deposit_type")
  depositPercentBps          Int?             @map("deposit_percent_bps") // 3000 = 30%
  depositFixedMinor          BigInt?          @map("deposit_fixed_minor")
  confirmationRule           ConfirmationRule @default(FULL_PAYMENT) @map("confirmation_rule")
  bankTransferWindowHours    Int              @default(24) @map("bank_transfer_window_hours")
  updatedById                String?          @map("updated_by_id") @db.Uuid
  createdAt                  DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@unique([divisionId, purpose])
  @@map("payment_policies")
}

// -----------------------------------------------------------------------------
// Luxury apartments
// -----------------------------------------------------------------------------

/// Whether an apartment or room can be sold right now. Only READY can be booked.
enum UnitReadiness {
  READY
  FINISHING
  NOT_READY
  SERVICING
  MAINTENANCE
}

model Property {
  id           String        @id @default(uuid()) @db.Uuid
  divisionId   String        @map("division_id") @db.Uuid
  name         String
  slug         String        @unique
  description  String?
  addressLine  String        @map("address_line")
  /// Grouping shown to staff and customers, for example Mabushi or Lagos.
  location     String?
  city         String
  state        String
  amenities    String[]
  checkInTime  String        @default("14:00") @map("check_in_time")
  checkOutTime String        @default("12:00") @map("check_out_time")
  status       ListingStatus @default(DRAFT)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  units    ApartmentUnit[]
  images   PropertyImage[]

  @@index([divisionId, status])
  @@index([city])
  @@index([location])
  @@map("properties")
}

model ApartmentUnit {
  id                  String             @id @default(uuid()) @db.Uuid
  propertyId          String             @map("property_id") @db.Uuid
  code                String
  name                String
  description         String?
  bedrooms            Int
  bathrooms           Float
  maxGuests           Int                @map("max_guests")
  nightlyRateMinor    BigInt             @map("nightly_rate_minor")
  cautionDepositMinor BigInt             @default(0) @map("caution_deposit_minor")
  cleaningFeeMinor    BigInt             @default(0) @map("cleaning_fee_minor")
  minNights           Int                @default(1) @map("min_nights")
  maxNights           Int                @default(90) @map("max_nights")
  verification        RecordVerification @default(AWAITING_CONFIRMATION)
  verifiedAt          DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById        String?            @map("verified_by_id") @db.Uuid
  status              ListingStatus      @default(DRAFT)
  readiness           UnitReadiness      @default(READY)
  readinessNote       String?            @map("readiness_note")
  createdAt           DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  property     Property        @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  images       PropertyImage[]
  rooms        ApartmentRoom[]
  reservations Reservation[]
  blackouts    UnitBlackout[]

  @@unique([propertyId, code])
  @@map("apartment_units")
}

/// A room that can be booked on its own. The whole unit stays bookable when no
/// room is taken; see the reservations_no_overlap constraint.
model ApartmentRoom {
  id                  String        @id @default(uuid()) @db.Uuid
  unitId              String        @map("unit_id") @db.Uuid
  slot                Int
  name                String
  description         String?
  maxGuests           Int           @default(2) @map("max_guests")
  nightlyRateMinor    BigInt        @map("nightly_rate_minor")
  cleaningFeeMinor    BigInt        @default(0) @map("cleaning_fee_minor")
  cautionDepositMinor BigInt        @default(0) @map("caution_deposit_minor")
  status              ListingStatus @default(ACTIVE)
  readiness           UnitReadiness @default(READY)
  readinessNote       String?       @map("readiness_note")
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit         ApartmentUnit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  reservations Reservation[]

  @@unique([unitId, slot])
  @@map("apartment_rooms")
}

model PropertyImage {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  unitId     String?  @map("unit_id") @db.Uuid
  url        String
  altText    String?  @map("alt_text")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  property Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit     ApartmentUnit? @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("property_images")
}

/// Maintenance / owner blocks. Overlaps with reservations are checked in
/// the service layer; overlaps between blackouts are allowed.
model UnitBlackout {
  id          String   @id @default(uuid()) @db.Uuid
  unitId      String   @map("unit_id") @db.Uuid
  startDate   DateTime @map("start_date") @db.Date
  endDate     DateTime @map("end_date") @db.Date // exclusive
  reason      String?
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  unit ApartmentUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([unitId, startDate])
  @@map("unit_blackouts")
}

/// Stays are [checkIn, checkOut) date ranges. An exclusion constraint in
/// migration.sql makes overlapping HOLD/CONFIRMED/CHECKED_IN reservations
/// on the same unit impossible, even under concurrent requests.
model Reservation {
  id                   String            @id @default(uuid()) @db.Uuid
  reservationNumber    String            @unique @map("reservation_number")
  unitId               String            @map("unit_id") @db.Uuid
  /// Set when one room is booked rather than the whole unit.
  roomId               String?           @map("room_id") @db.Uuid
  /// Copy of the room's slot, used by the double-booking constraint.
  roomSlot             Int?              @map("room_slot")
  userId               String            @map("user_id") @db.Uuid
  checkIn              DateTime          @map("check_in") @db.Date
  checkOut             DateTime          @map("check_out") @db.Date
  nights               Int
  guests               Int
  status               ReservationStatus @default(HOLD)
  paymentStatus        PayableState      @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt            @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt            @default(0) @map("deposit_required_minor")
  holdExpiresAt        DateTime?         @map("hold_expires_at") @db.Timestamptz(3)
  nightlyRateMinor     BigInt            @map("nightly_rate_minor")
  accommodationMinor   BigInt            @map("accommodation_minor")
  cleaningFeeMinor     BigInt            @map("cleaning_fee_minor")
  cautionDepositMinor  BigInt            @map("caution_deposit_minor")
  totalMinor           BigInt            @map("total_minor")
  currency             String            @default("NGN") @db.Char(3)
  guestNote            String?           @map("guest_note")
  idempotencyKey       String?           @map("idempotency_key")
  confirmedAt          DateTime?         @map("confirmed_at") @db.Timestamptz(3)
  cancelledAt          DateTime?         @map("cancelled_at") @db.Timestamptz(3)
  cancellationReason   String?           @map("cancellation_reason")
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  unit     ApartmentUnit  @relation(fields: [unitId], references: [id], onDelete: Restrict)
  room     ApartmentRoom? @relation(fields: [roomId], references: [id], onDelete: Restrict)
  user     User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([userId, idempotencyKey])
  @@index([roomId])
  @@index([unitId, checkIn])
  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
  @@map("reservations")
}

// -----------------------------------------------------------------------------
// Automobiles
// -----------------------------------------------------------------------------

model Vehicle {
  id             String             @id @default(uuid()) @db.Uuid
  divisionId     String             @map("division_id") @db.Uuid
  slug           String             @unique
  make           String
  model          String
  year           Int
  trim           String?
  condition      VehicleCondition?
  bodyType       String?            @map("body_type")
  transmission   String?
  fuelType       String?            @map("fuel_type")
  colour         String?
  mileageKm      Int?               @map("mileage_km")
  vin            String?            @unique
  priceMinor     BigInt?            @map("price_minor")
  depositMinor   BigInt?            @map("deposit_minor")
  customsCleared Boolean            @default(false) @map("customs_cleared")
  verification   RecordVerification @default(AWAITING_CONFIRMATION)
  verifiedAt     DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById   String?            @map("verified_by_id") @db.Uuid
  specs          Json?
  description    String?
  status         VehicleStatus      @default(DRAFT)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  division  Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  images    VehicleImage[]
  inquiries VehicleInquiry[]

  @@index([status, make, model])
  @@index([divisionId, status])
  @@map("vehicles")
}

model VehicleImage {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId])
  @@map("vehicle_images")
}

model VehicleInquiry {
  id                   String        @id @default(uuid()) @db.Uuid
  vehicleId            String        @map("vehicle_id") @db.Uuid
  userId               String?       @map("user_id") @db.Uuid
  type                 InquiryType   @default(GENERAL)
  status               InquiryStatus @default(NEW)
  paymentStatus        PayableState  @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt        @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt        @default(0) @map("deposit_required_minor")
  contactName          String        @map("contact_name")
  contactEmail         String        @map("contact_email")
  contactPhone         String        @map("contact_phone")
  message              String?
  preferredDate        DateTime?     @map("preferred_date") @db.Timestamptz(3)
  assignedToId         String?       @map("assigned_to_id") @db.Uuid
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  user       User?     @relation("InquiryCustomer", fields: [userId], references: [id], onDelete: SetNull)
  assignedTo User?     @relation("InquiryAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  payments   Payment[]

  @@index([vehicleId])
  @@index([status, createdAt])
  @@map("vehicle_inquiries")
}

// -----------------------------------------------------------------------------
// Generic service bookings (automotive services, media/event rentals,
// interior design consultations, entertainment experiences, ...)
// -----------------------------------------------------------------------------

model ServiceOffering {
  id              String             @id @default(uuid()) @db.Uuid
  divisionId      String             @map("division_id") @db.Uuid
  code            String             @unique
  name            String
  description     String?
  imageUrl        String?            @map("image_url")
  pricingType     ServicePricingType @default(FIXED) @map("pricing_type")
  basePriceMinor  BigInt?            @map("base_price_minor")
  depositMinor    BigInt?            @map("deposit_minor")
  durationMinutes Int?               @map("duration_minutes")
  verification    RecordVerification @default(AWAITING_CONFIRMATION)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById    String?            @map("verified_by_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division         @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  bookings ServiceBooking[]

  @@index([divisionId, isActive])
  @@map("service_offerings")
}

model ServiceBooking {
  id                   String        @id @default(uuid()) @db.Uuid
  bookingNumber        String        @unique @map("booking_number")
  offeringId           String        @map("offering_id") @db.Uuid
  divisionId           String        @map("division_id") @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  status               BookingStatus @default(REQUESTED)
  paymentStatus        PayableState  @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt        @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt        @default(0) @map("deposit_required_minor")
  scheduledStart       DateTime?     @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd         DateTime?     @map("scheduled_end") @db.Timestamptz(3)
  priceMinor           BigInt?       @map("price_minor")
  details              Json? // e.g. vehicle make/model/plate for auto services
  customerNote         String?       @map("customer_note")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  offering   ServiceOffering @relation(fields: [offeringId], references: [id], onDelete: Restrict)
  division   Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments   Payment[]
  quotations Quotation[]

  @@index([divisionId, status, scheduledStart])
  @@index([userId, createdAt])
  @@map("service_bookings")
}

// -----------------------------------------------------------------------------
// Spa & wellness
// -----------------------------------------------------------------------------

model SpaTreatment {
  id              String             @id @default(uuid()) @db.Uuid
  divisionId      String             @map("division_id") @db.Uuid
  name            String
  slug            String             @unique
  description     String?
  imageUrl        String?            @map("image_url")
  category        String?
  durationMinutes Int                @map("duration_minutes")
  priceMinor      BigInt             @map("price_minor")
  depositMinor    BigInt             @default(0) @map("deposit_minor")
  verification    RecordVerification @default(AWAITING_CONFIRMATION)
  verifiedAt      DateTime?          @map("verified_at") @db.Timestamptz(3)
  verifiedById    String?            @map("verified_by_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  division      Division                   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  practitioners SpaPractitionerTreatment[]
  appointments  SpaAppointment[]

  @@index([divisionId, isActive])
  @@map("spa_treatments")
}

model SpaPractitioner {
  id             String   @id @default(uuid()) @db.Uuid
  divisionId     String   @map("division_id") @db.Uuid
  staffProfileId String?  @unique @map("staff_profile_id") @db.Uuid
  displayName    String   @map("display_name")
  bio            String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division     Division                   @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  staffProfile StaffProfile?              @relation(fields: [staffProfileId], references: [id], onDelete: SetNull)
  treatments   SpaPractitionerTreatment[]
  appointments SpaAppointment[]

  @@map("spa_practitioners")
}

model SpaPractitionerTreatment {
  practitionerId String @map("practitioner_id") @db.Uuid
  treatmentId    String @map("treatment_id") @db.Uuid

  practitioner SpaPractitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  treatment    SpaTreatment    @relation(fields: [treatmentId], references: [id], onDelete: Cascade)

  @@id([practitionerId, treatmentId])
  @@map("spa_practitioner_treatments")
}

/// An exclusion constraint (migration.sql) prevents overlapping active
/// appointments for the same practitioner.
model SpaAppointment {
  id                   String        @id @default(uuid()) @db.Uuid
  appointmentNumber    String        @unique @map("appointment_number")
  treatmentId          String        @map("treatment_id") @db.Uuid
  practitionerId       String?       @map("practitioner_id") @db.Uuid
  userId               String        @map("user_id") @db.Uuid
  startsAt             DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt               DateTime      @map("ends_at") @db.Timestamptz(3)
  status               BookingStatus @default(REQUESTED)
  paymentStatus        PayableState  @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt        @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt        @default(0) @map("deposit_required_minor")
  priceMinor           BigInt        @map("price_minor")
  depositMinor         BigInt        @default(0) @map("deposit_minor")
  customerNote         String?       @map("customer_note")
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  treatment    SpaTreatment     @relation(fields: [treatmentId], references: [id], onDelete: Restrict)
  practitioner SpaPractitioner? @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  payments     Payment[]

  @@index([practitionerId, startsAt])
  @@index([userId, startsAt])
  @@map("spa_appointments")
}

// -----------------------------------------------------------------------------
// Transport & logistics
// -----------------------------------------------------------------------------

model LogisticsRequest {
  id                   String          @id @default(uuid()) @db.Uuid
  trackingNumber       String          @unique @map("tracking_number")
  divisionId           String          @map("division_id") @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  type                 LogisticsType
  status               LogisticsStatus @default(REQUESTED)
  paymentStatus        PayableState    @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt          @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt          @default(0) @map("deposit_required_minor")
  originAddress        Json            @map("origin_address")
  destinationAddress   Json            @map("destination_address")
  packageDescription   String          @map("package_description")
  weightGrams          Int?            @map("weight_grams")
  declaredValueMinor   BigInt?         @map("declared_value_minor")
  quotedPriceMinor     BigInt?         @map("quoted_price_minor")
  pickupDate           DateTime?       @map("pickup_date") @db.Date
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  division   Division        @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  user       User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  events     ShipmentEvent[]
  payments   Payment[]
  quotations Quotation[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("logistics_requests")
}

model ShipmentEvent {
  id                 String          @id @default(uuid()) @db.Uuid
  logisticsRequestId String          @map("logistics_request_id") @db.Uuid
  status             LogisticsStatus
  location           String?
  note               String?
  actorId            String?         @map("actor_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  logisticsRequest LogisticsRequest @relation(fields: [logisticsRequestId], references: [id], onDelete: Cascade)

  @@index([logisticsRequestId, createdAt])
  @@map("shipment_events")
}

// -----------------------------------------------------------------------------
// Quotations (any division: logistics, real estate, interior design,
// media/event rentals, wholesale drinks, retail tenders ...)
// -----------------------------------------------------------------------------

model Quotation {
  id                   String          @id @default(uuid()) @db.Uuid
  quoteNumber          String          @unique @map("quote_number")
  divisionId           String          @map("division_id") @db.Uuid
  userId               String          @map("user_id") @db.Uuid
  serviceBookingId     String?         @map("service_booking_id") @db.Uuid
  logisticsRequestId   String?         @map("logistics_request_id") @db.Uuid
  subject              String
  requestDetails       String          @map("request_details")
  status               QuotationStatus @default(REQUESTED)
  paymentStatus        PayableState    @default(UNPAID) @map("payment_status")
  amountPaidMinor      BigInt          @default(0) @map("amount_paid_minor")
  depositRequiredMinor BigInt          @default(0) @map("deposit_required_minor")
  currency             String          @default("NGN") @db.Char(3)
  totalMinor           BigInt?         @map("total_minor")
  validUntil           DateTime?       @map("valid_until") @db.Timestamptz(3)
  preparedById         String?         @map("prepared_by_id") @db.Uuid
  sentAt               DateTime?       @map("sent_at") @db.Timestamptz(3)
  respondedAt          DateTime?       @map("responded_at") @db.Timestamptz(3)
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  division         Division          @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  user             User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  serviceBooking   ServiceBooking?   @relation(fields: [serviceBookingId], references: [id], onDelete: SetNull)
  logisticsRequest LogisticsRequest? @relation(fields: [logisticsRequestId], references: [id], onDelete: SetNull)
  items            QuotationItem[]
  payments         Payment[]

  @@index([divisionId, status, createdAt])
  @@index([userId, createdAt])
  @@map("quotations")
}

model QuotationItem {
  id             String @id @default(uuid()) @db.Uuid
  quotationId    String @map("quotation_id") @db.Uuid
  description    String
  quantity       Int
  unitPriceMinor BigInt @map("unit_price_minor")
  lineTotalMinor BigInt @map("line_total_minor")
  sortOrder      Int    @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

// -----------------------------------------------------------------------------
// Green Wallet loyalty (points only — not stored value)
// -----------------------------------------------------------------------------

model LoyaltyAccount {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @unique @map("user_id") @db.Uuid
  pointsBalance  Int      @default(0) @map("points_balance")
  lifetimeEarned Int      @default(0) @map("lifetime_earned")
  tier           String   @default("GREEN")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@map("loyalty_accounts")
}

/// Earn rate per division, in hundredths of a point per ₦100 spent
/// (e.g. 150 = 1.5 points per ₦100).
model LoyaltyRule {
  id                  String   @id @default(uuid()) @db.Uuid
  divisionId          String   @unique @map("division_id") @db.Uuid
  pointsPer100NgnX100 Int      @map("points_per_100_ngn_x100")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  division Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@map("loyalty_rules")
}

model LoyaltyTransaction {
  id           String        @id @default(uuid()) @db.Uuid
  accountId    String        @map("account_id") @db.Uuid
  type         LoyaltyTxType
  points       Int // signed
  balanceAfter Int           @map("balance_after")
  divisionId   String?       @map("division_id") @db.Uuid
  sourceType   String?       @map("source_type") // e.g. "payment"
  sourceId     String?       @map("source_id")
  description  String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  account  LoyaltyAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  division Division?      @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  // Prevents awarding points twice for the same source event.
  @@unique([type, sourceType, sourceId])
  @@index([accountId, createdAt])
  @@map("loyalty_transactions")
}

// -----------------------------------------------------------------------------
// Notifications & audit
// -----------------------------------------------------------------------------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  channel   NotificationChannel @default(IN_APP)
  type      String // e.g. "order.paid"
  title     String
  body      String
  data      Json?
  status    NotificationStatus  @default(QUEUED)
  sentAt    DateTime?           @map("sent_at") @db.Timestamptz(3)
  readAt    DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String // e.g. "product.update", "auth.login.failed"
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id")
  divisionId String?  @map("division_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  changes    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  division Division? @relation(fields: [divisionId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@index([divisionId, createdAt])
  @@map("audit_logs")
}

enum FavoriteKind {
  PRODUCT
  PROPERTY
  VEHICLE
  TREATMENT
}

/// Something a customer has saved. Slugs keep the list simple across listing types.
enum HomeSlideKind {
  PICTURE
  PRODUCT
  APARTMENTS
}

/// A promo or featured item on the customer home page.
model HomeSlide {
  id         String        @id @default(uuid()) @db.Uuid
  kind       HomeSlideKind
  title      String?
  subtitle   String?
  buttonText String?       @map("button_text")
  imageUrl   String?       @map("image_url")
  linkTo     String?       @map("link_to")
  productId  String?       @map("product_id") @db.Uuid
  tone       String        @default("sky")
  sortOrder  Int           @default(0) @map("sort_order")
  isActive   Boolean       @default(true) @map("is_active")
  startsAt   DateTime?     @map("starts_at") @db.Timestamptz(3)
  endsAt     DateTime?     @map("ends_at") @db.Timestamptz(3)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([isActive, sortOrder])
  @@index([productId])
  @@map("home_slides")
}

model Favorite {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  kind      FavoriteKind
  itemSlug  String       @map("item_slug")
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, itemSlug])
  @@index([userId, createdAt])
  @@map("favorites")
}
