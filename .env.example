# -----------------------------------------------------------------------------
# Nimpat One API — example environment (LOCAL DEVELOPMENT ONLY)
# Copy to .env and adjust. Never commit a real .env. In Cloud Run, inject
# secrets from Google Secret Manager instead of using a file.
# -----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed by CORS.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
# Public URL of the customer app — used to build email links and Paystack callbacks.
APP_PUBLIC_URL=http://localhost:3002
# Public URL of the staff dashboard, used for staff invitation links.
ADMIN_PUBLIC_URL=http://localhost:3001
# Folder for staff-uploaded photos. In production, point this at a mounted Cloud Storage bucket.
# PHOTO_STORAGE_DIR=/mnt/nimpat-photos
# Trust X-Forwarded-* headers (needed behind Cloud Run / load balancers).
TRUST_PROXY=true

# PostgreSQL (matches docker-compose.yml)
NIMPAT_DB_PASSWORD=choose-a-local-db-password
DATABASE_URL=postgresql://nimpat:choose-a-local-db-password@localhost:5432/nimpat_one?schema=public

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev-only-change-me-access-secret-min-32-chars-xxxxxxxx
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30
REQUIRE_VERIFIED_EMAIL_FOR_PAYMENT=true

# Rate limiting (requests per window, per client IP)
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# Paystack — TEST MODE ONLY. Get test keys from the Paystack dashboard
# (Settings -> API Keys & Webhooks). Live keys are rejected at startup.
# "test" here, always. Production switches to "live" only after test-mode payments have passed.
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:3002/payments/callback
# Optional: only accept webhooks from Paystack's published IPs.
PAYSTACK_WEBHOOK_IP_ALLOWLIST=

# Commerce rules
ORDER_PAYMENT_TTL_MINUTES=30
APARTMENT_HOLD_TTL_MINUTES=15
SPA_HOLD_TTL_MINUTES=20
BUSINESS_TIMEZONE=Africa/Lagos

# Background jobs: run expiry/reconciliation timers inside the API process
# (fine locally). On Cloud Run set to false and call /v1/internal/jobs/*
# from Cloud Scheduler with the X-Job-Token header.
JOBS_INPROCESS=true
JOBS_TOKEN=dev-only-job-token-change-me

# Mail: "console" logs emails (development). "resend" sends them through Resend.
# RESEND_API_KEY is a secret: keep it out of this file and out of Git. In production it comes from
# Google Secret Manager (secret nimpat-one-resend-api-key); locally, put it only in your own .env.
MAIL_TRANSPORT=console
EMAIL_FROM="Nimpat One <no-reply@notify.nimpatgroup.com>"
RESEND_API_KEY=

# Development seed (prisma/seed.ts). The seed creates one local super admin
# with these credentials. Development/test values only.
SEED_ADMIN_EMAIL=dev.admin@nimpat.test
SEED_ADMIN_PASSWORD=choose-a-strong-local-password
# Adds clearly-labelled [DEV SAMPLE] catalogue/listing data for local testing.
SEED_SAMPLE_DATA=true
